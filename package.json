{
  "name": "n0launcher",
  "version": "1.0.5",
  "author": "N0rach",
  "description": "N0Launcher make with love Minecraft",
  "private": true,
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "npm run build && electron .",
    "dev:mon": "npm run build && nodemon --exec electron .",
    "build": "vite build && node scripts/build-main.js",
    "pack": "npm run build && electron-builder",
    "pack:win": "npm run build && electron-builder --win",
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.5.0",
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "^6.1.2",
    "@xmcl/mod-parser": "^3.4.2",
    "@xmcl/resourcepack": "^1.2.5",
    "@xmcl/task": "^4.1.1",
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.3.6",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "prismarine-auth": "3.1.1",
    "undici": "7.2.3"
  },
  "build": {
    "appId": "com.n0launcher",
    "productName": "N0Launcher",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "panadorado",
      "repo": "minecraft_n0launcher"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "!**/*.map",
      "!dist/renderer/assets/*.js.map"
    ],
    "win": {
      "icon": "src/renderer/assets/N0Launcher.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "differentialPackage": true
    }
  },
  "overrides": {
    "undici": "7.2.3",
    "@xmcl/core": "2.15.1"
  }
}
